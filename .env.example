# Settings for docker-compose.yml. Unset ones take their default, and a typo
# stops the server with the setting's name in `docker compose logs`.
# Every setting: docs/deploy-reference.md#environment-variables

# CHANGE: the release to run, without the v. Pinned, a restart never upgrades.
SHOPPINGLIST_VERSION=X.Y.Z

# CHANGE: the bare domain the app is served on (no https://, no port, no IP).
# Passkeys belong to it: changing it later means everyone registers again.
SHOPPINGLIST_RP_ID=list.example.com

# Who can sign up: invite (through a list's invite link; the first account
# through the setup link in the log), open (anyone) or closed (no one new).
SHOPPINGLIST_SIGNUP=invite

# The header your proxy puts the client's address in, for per-user rate limits.
SHOPPINGLIST_TRUSTED_PROXY_HEADER=X-Forwarded-For
# Read its leftmost address: only behind a proxy chain whose every hop
# overwrites it (docs/deploy-reference.md#only-if-you-run-a-proxy-chain).
# SHOPPINGLIST_TRUSTED_PROXY_LEFTMOST=on

# --- Optional ---

# The full origin, when the address bar shows more than https://<RP_ID>.
# SHOPPINGLIST_RP_ORIGIN=https://list.example.com:8443

# No admin dashboard at /_/. Set up backups there first (docs/operating.md#backups).
# SHOPPINGLIST_ADMIN_UI=off

# No barcode scanner, and no requests to Open Food Facts.
# SHOPPINGLIST_SCANNER=off

# What one account can store. The first also caps one import, where it is
# below a backup's own 2000.
# SHOPPINGLIST_MAX_ITEMS_PER_LIST=5000
# SHOPPINGLIST_MAX_LISTS_PER_ACCOUNT=25

# Sign-in through your OpenID Connect provider, with
# https://<your domain>/api/oauth2-redirect as its redirect URI
# (docs/deploy-reference.md#oidc-login). The name is the button's label,
# "OIDC" when unset.
# SHOPPINGLIST_OIDC=on
# SHOPPINGLIST_OIDC_CLIENT_ID=shoppinglist
# SHOPPINGLIST_OIDC_CLIENT_SECRET=…
# SHOPPINGLIST_OIDC_ISSUER=https://idp.example.com/realms/home
# SHOPPINGLIST_OIDC_NAME=Keycloak
# The provider only, no passkeys (docs/deploy-reference.md#choosing-the-login-methods):
# SHOPPINGLIST_PASSKEYS=off
# SHOPPINGLIST_APP_URL=https://list.example.com

# A modified version must link to its own source (AGPL-3.0).
# SHOPPINGLIST_SOURCE_URL=https://codeberg.org/you/shoppinglist

# Only for a data volume on NFS or virtiofs: the value is in
# docs/deploy-reference.md#sqlite-on-network-storage
# SQLITE_PRAGMAS=

# Publish the app on every interface, only for a reverse proxy on another
# machine: docs/deploy-reference.md#2-do-not-expose-the-container-port
# SHOPPINGLIST_BIND=8090
