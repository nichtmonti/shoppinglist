{
	"name": "frontend",
	"private": true,
	"license": "AGPL-3.0-only",
	"version": "0.0.1",
	"type": "module",
	"imports": {
		"#demo": {
			"demo": "./src/lib/demo/on.ts",
			"default": "./src/lib/demo/off.ts"
		},
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo '' && npm run paraglide:compile",
		"paraglide:compile": "paraglide-js compile --project ./project.inlang",
		"check": "svelte-kit sync && npm run paraglide:compile && svelte-check --tsconfig ./tsconfig.json && npm run check:worker",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:worker": "tsc --noEmit -p src/service-worker/tsconfig.json",
		"lint": "node scripts/lint.js",
		"lint:fast": "eslint -c eslint.syntactic.config.js --cache --cache-location node_modules/.cache/eslint-syntactic .",
		"test:unit": "vitest --project server --project client",
		"test:client": "vitest --project client",
		"test:integration": "vitest --project integration --run",
		"test": "npm run test:unit -- --run"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@fontsource-variable/readex-pro": "5.3.0",
		"@inlang/paraglide-js": "2.29.1",
		"@inlang/plugin-message-format": "4.5.5",
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@testing-library/svelte": "5.4.2",
		"@testing-library/user-event": "14.6.8",
		"@types/node": "26.6.5",
		"@vitest/coverage-v8": "5.0.5",
		"eslint": "10.13.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-import-resolver-typescript": "4.4.5",
		"eslint-plugin-better-tailwindcss": "4.10.0",
		"eslint-plugin-boundaries": "7.2.0",
		"eslint-plugin-no-unsanitized": "4.1.5",
		"eslint-plugin-svelte": "3.23.1",
		"fake-indexeddb": "6.2.6",
		"globals": "17.13.0",
		"happy-dom": "21.0.4",
		"knip": "6.42.1",
		"openmoji": "17.0.0",
		"svelte": "5.57.2",
		"svelte-check": "4.7.7",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.0",
		"vite": "8.3.5",
		"vitest": "5.0.5"
	},
	"dependencies": {
		"@lucide/svelte": "1.61.0",
		"@simplewebauthn/browser": "14.0.0",
		"@use-gesture/vanilla": "10.3.1",
		"barcode-detector": "3.2.3",
		"bits-ui": "2.20.0",
		"clsx": "2.1.1",
		"dexie": "4.4.7",
		"mode-watcher": "1.1.0",
		"photoswipe": "5.4.4",
		"pocketbase": "0.28.1",
		"qrcode-generator": "2.0.4",
		"svelte-dnd-action": "0.9.80",
		"svelte-sonner": "1.2.1",
		"tailwind-merge": "3.7.0",
		"tailwind-variants": "3.3.1",
		"tw-animate-css": "1.4.0",
		"vaul-svelte": "1.0.0-next.7",
		"zxing-wasm": "3.1.6"
	}
}
